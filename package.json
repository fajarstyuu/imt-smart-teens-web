{
  "name": "imt-smart-teens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/publish.mjs",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "test": "npm run test:legacy-domain && vitest run",
    "test:legacy-domain": "node --test tests/domain.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:zoom": "playwright test --config playwright.zoom.config.ts",
    "test:api": "playwright test tests/rust.spec.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "^4.1.12"
  }
}
